# ── GitHub ───────────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxxx
# DIGEST_REPO=owner/repo          # 省略则跳过 GitHub Issue 创建

# ── LLM Provider ─────────────────────────────────────────
# 主 provider: anthropic | openai | github-copilot | openrouter | deepseek
LLM_PROVIDER=openai

# OpenAI 兼容（Mimo 示例）
OPENAI_API_KEY=sk-xxxxx
OPENAI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
OPENAI_MODEL=mimo-v2.5

# Anthropic（默认 provider，无需设 LLM_PROVIDER）
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenRouter
# OPENROUTER_API_KEY=sk-or-xxxxx
# OPENROUTER_MODEL=anthropic/claude-sonnet-4

# GitHub Copilot — 复用 GITHUB_TOKEN，无需额外 key
# GITHUB_COPILOT_MODEL=gpt-4o

# ── Fallback Provider ────────────────────────────────────
# 主 provider 失败时自动切换
LLM_FALLBACK_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxxxx
DEEPSEEK_MODEL=DeepSeek-V4-Flash

# ── Telegram 通知（可选）──────────────────────────────────
# TELEGRAM_BOT_TOKEN=bot_token
# TELEGRAM_CHAT_ID=@channel_name

# ── 飞书通知（可选）──────────────────────────────────────
# 方式一：Open API（推荐，使用飞书应用）
FEISHU_APP_ID=cli_xxxxx
FEISHU_APP_SECRET=xxxxx
FEISHU_CHAT_ID=oc_xxxxx
# 方式二：Webhook（简单，使用群机器人）
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxx

# ── 其他数据源 ───────────────────────────────────────────
# PRODUCTHUNT_TOKEN=xxxxx

# ── 运行时选项 ───────────────────────────────────────────
# DRY_RUN=true                     # 预览模式，输出到 digests/preview-*/
# LANGUAGES=zh                     # 报告语言（zh / en / zh,en）
# PAGES_URL=https://xxx.github.io  # 站点 URL
